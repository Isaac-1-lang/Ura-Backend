// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  FIELD_AGENT
  DONOR_VIEWER
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  COMPLETED
  SUSPENDED
}

enum VulnerabilityCategory {
  EXTREME
  HIGH
  MODERATE
  LOW
}

model User {
  id           String   @id @default(uuid())
  firstName    String
  lastName     String
  email        String   @unique
  passwordHash String
  role         Role     @default(FIELD_AGENT)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Organization {
  id                 String    @id @default(uuid())
  name               String
  registrationNumber String    @unique
  sectorOfFocus      String
  projects           Project[]
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model Project {
  id             String         @id @default(uuid())
  name           String
  description    String?
  budget         Float
  startDate      DateTime
  endDate        DateTime?
  targetProvince String
  targetDistrict String
  status         ProjectStatus  @default(PLANNING)
  
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id])
  
  distributions  Distribution[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model Beneficiary {
  id                    String                @id @default(uuid())
  fullName              String
  nationalId            String                @unique
  householdSize         Int
  province              String
  district              String
  sector                String
  cell                  String
  village               String
  vulnerabilityCategory VulnerabilityCategory @default(MODERATE)
  
  distributions         Distribution[]
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
}

model Distribution {
  id               String       @id @default(uuid())
  itemType         String
  quantity         Float
  location         String
  distributionDate DateTime
  notes            String?
  
  projectId        String
  project          Project      @relation(fields: [projectId], references: [id])
  
  beneficiaryId    String
  beneficiary      Beneficiary  @relation(fields: [beneficiaryId], references: [id])
  
  fieldAgentId     String
  
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
}

model Notification {
  id        String   @id @default(uuid())
  title     String
  message   String
  recipient String   
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}
